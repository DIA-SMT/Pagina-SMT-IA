<!-- search popup start -->
<div class="search__popup">
      <div class="container">
         <div class="row">
            <div class="col-xxl-12">
               <div class="search__wrapper">
                  <div class="search__top d-flex justify-content-between align-items-center">
                     <div class="search__logo">
                        <a href="/">
                           <img src="/assets/img/muni/logo/Logo_SMT_neg_1.png" alt="">
                        </a>
                     </div>
                     <div class="search__close">
                        <button type="button" class="search__close-btn search-close-btn">
                           <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                              <path d="M17 1L1 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                              <path d="M1 1L17 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                           </svg>
                        </button>
                     </div>
                  </div>
                  <div class="search__form">
                     <form action="/search/result" method="get">
                        <div class="search__input">
                           <input class="search-input-field" type="text" name="q" required placeholder="Buscar...">
                           <span class="search-focus-border"></span>
                           <button type="submit">
                              <svg width="20" height="20" viewBox="0 0 20 20" fill="none"
                                 xmlns="http://www.w3.org/2000/svg">
                                 <path
                                    d="M9.55 18.1C14.272 18.1 18.1 14.272 18.1 9.55C18.1 4.82797 14.272 1 9.55 1C4.82797 1 1 4.82797 1 9.55C1 14.272 4.82797 18.1 9.55 18.1Z"
                                    stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
                                    stroke-linejoin="round" />
                                 <path d="M19.0002 19.0002L17.2002 17.2002" stroke="currentColor" stroke-width="1.5"
                                    stroke-linecap="round" stroke-linejoin="round" />
                              </svg>
                           </button>
                        </div>
                     </form>
                  </div>
               </div>
            </div>
         </div>
      </div>
   </div>
   <!-- search popup end -->

   <!-- navbar-movil -->
   <div class="tpoffcanvas-area">
      <div class="tpoffcanvas">
         <div class="tpoffcanvas__close-btn">
            <button class="close-btn"><i class="fal fa-times"></i></button>
         </div>
         <div class="tpoffcanvas__logo">
            <a href="/">
               <img src="/assets/img/muni/logo/Logo_SMT_neg_1.png" style="width: 90%;" alt="">
            </a>
         </div>
         <div class="tp-main-menu-mobile d-xl-none">
            <nav class="tp-main-menu-content">
               {{menu('menu')}}
              <ul>
                  <li>
                     <a href="https://ciudaddigital.smt.gob.ar/" target="_blank" class="btn btn-cidi">Ingresar a CiDiTuc</a>
                 </li>
               </ul> 
            </nav>
         </div>
         <div class="tpoffcanvas__contact-info">
            <div class="tpoffcanvas__contact-title">
               <h5>Contacto</h5>
            </div>
            <ul>
               <li>
                  <i class="fa-light fa-location-dot"></i>
                  <a href="" target="_blank">Dirección: 9 De Julio 598 Sur, T4000 San Miguel De Tucumán, Tucumán</a>
               </li>
               <li>
                  <i class="fal fa-phone-alt"></i>
                  <a href="">Municipalidad: 4516500</a>
               </li>
               <li>
                  <i class="fal fa-phone-alt"></i>
                  <a href="">Asistencia Pública: 4308393</a>
               </li>
               <li>
                  <i class="fal fa-phone-alt"></i>
                  <a href="">Asistencia Pública: 4212329</a>
               </li>
            </ul>
         </div>
         <div class="tpoffcanvas__social">
            <div class="social-icon">
               <a href="#"><i class="fab fa-twitter"></i></a>
               <a href="#"><i class="fab fa-instagram"></i></a>
               <a href="#"><i class="fab fa-facebook-f"></i></a>
               <a href="#"><i class="fab fa-youtube"></i></a>
            </div>
         </div>
      </div>
   </div>
   <div class="body-overlay"></div>
   <!-- navbar-movil end -->

   <header class="tp-header-height">
      <div id="header-sticky" class="tp-header-area tp-header-plr">
         <div class="container-fluid px-5">
            <div class="row align-items-center">
               <div class="col-xxl-2 col-xl-2 col-lg-6 col-md-6 col-8">
                  <div class="tp-header-logo">
                    <a href="/">
                        <img src="/assets/img/muni/logo/Logo_SMT_pos_1.png" class="img-fluid" alt="">
                    </a>
                  </div>
               </div>
               <div class="col-xxl-8 col-xl-9 d-none d-xl-block">
                  <div class="tp-header-menu">
                    <nav class="tp-main-menu-content d-flex align-items-center">
                        {{menu('menu')}}
                        <ul>
                           <li>
                              <a href="https://ciudaddigital.smt.gob.ar/" target="_blank" class="btn btn-cidi">Ingresar a CiDiTuc</a>
                          </li>
                        </ul>
                     </nav>
                  </div>
               </div>
               <div class="col-xxl-1 col-xl-1 col-lg-6 col-md-6 col-4">
                  <div class="tp-header-right-box">
                     <div class="tp-header-right-action d-flex align-items-center justify-content-end">
                        <div class="tp-header-right-search d-none d-sm-block">
                           <button class="search-open-btn mx-2"><i class="fa-regular fa-magnifying-glass"></i></button>
                        </div>                     
                        <div class="tp-header-bar d-xl-none text-end ">
                           <button class="tp-menu-bar">
                               <i class="fa-light fa-bars-staggered"></i>
                           </button>
                       </div>
                     </div>
                  </div>
               </div>
            </div>
         </div>
      </div>
      <!-- header area end -->
   </header>